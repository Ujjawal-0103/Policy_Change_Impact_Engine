// Prisma Schema — Policy Change Impact Engine
// Foundation Phase: core entities only, intentionally simple.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User & Organization ─────────────────────────────────────────────────────

model User {
  id        String        @id @default(cuid())
  email     String        @unique
  name      String
  password  String // Hashed — never store plain text
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id])
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  documents       Document[]
  assignedActions Action[]        @relation("AssignedActions")
  actionHistory   ActionHistory[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  documents Document[]
  policies  Policy[]
}

// ─── Documents & Pages ───────────────────────────────────────────────────────

model Document {
  id           String   @id @default(cuid())
  title        String
  originalName String
  mimeType     String
  storageUrl   String // Cloudinary URL
  uploadedById String
  orgId        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy     User            @relation(fields: [uploadedById], references: [id])
  org            Organization    @relation(fields: [orgId], references: [id])
  pages          DocumentPage[]
  policyVersions PolicyVersion[]
}

model DocumentPage {
  id         String   @id @default(cuid())
  documentId String
  pageNumber Int
  content    String   @db.Text // Raw extracted text — populated later by AI
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

// ─── Policies & Versions ─────────────────────────────────────────────────────

model Policy {
  id          String   @id @default(cuid())
  name        String
  description String?
  orgId       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org      Organization    @relation(fields: [orgId], references: [id])
  versions PolicyVersion[]
  changes  PolicyChange[]
}

model PolicyVersion {
  id            String              @id @default(cuid())
  policyId      String
  versionNumber Int
  documentId    String
  status        PolicyVersionStatus @default(DRAFT)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  policy       Policy         @relation(fields: [policyId], references: [id])
  document     Document       @relation(fields: [documentId], references: [id])
  requirements Requirement[]
  changesFrom  PolicyChange[] @relation("ChangeFromVersion")
  changesTo    PolicyChange[] @relation("ChangeToVersion")

  @@unique([policyId, versionNumber])
}

enum PolicyVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// ─── Requirements & Actions ───────────────────────────────────────────────────

model Requirement {
  id              String    @id @default(cuid())
  policyVersionId String
  title           String
  description     String    @db.Text
  deadline        DateTime?
  priority        Priority  @default(MEDIUM)
  responsibleRole String?
  evidenceNeeded  String?
  sourcePage      Int?
  sourceText      String?   @db.Text
  category        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  policyVersion PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  actions       Action[]
  impacts       Impact[]
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Action {
  id            String       @id @default(cuid())
  requirementId String
  title         String
  description   String       @db.Text
  status        ActionStatus @default(PENDING)
  priority      Priority     @default(MEDIUM)
  department    String?
  assignedToId  String?
  deadline      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  requirement  Requirement        @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  assignedTo   User?              @relation("AssignedActions", fields: [assignedToId], references: [id])
  evidence     Evidence[]
  history      ActionHistory[]
  dependencies ActionDependency[] @relation("ActionDeps")
  dependents   ActionDependency[] @relation("DependentActions")
  impacts      Impact[]
}

enum ActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  BLOCKED
}

model ActionDependency {
  id          String @id @default(cuid())
  actionId    String // The action that depends on another
  dependsOnId String // The action it depends on

  action    Action @relation("ActionDeps", fields: [actionId], references: [id], onDelete: Cascade)
  dependsOn Action @relation("DependentActions", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([actionId, dependsOnId])
}

// ─── Evidence ────────────────────────────────────────────────────────────────

model Evidence {
  id          String   @id @default(cuid())
  actionId    String
  title       String
  description String?
  fileUrl     String? // Cloudinary URL
  createdAt   DateTime @default(now())

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)
}

// ─── Policy Changes & Impact ─────────────────────────────────────────────────

model PolicyChange {
  id              String     @id @default(cuid())
  policyId        String
  fromVersionId   String
  toVersionId     String
  changeType      ChangeType
  fieldChanged    String?    // e.g. REQUIREMENT, DEADLINE, EVIDENCE, PRIORITY, RESPONSIBILITY
  description     String     @db.Text
  affectedSection String?
  oldValue        String?    @db.Text
  newValue        String?    @db.Text
  sourceReference String?    @db.Text
  confidence      Float?
  createdAt       DateTime   @default(now())

  policy      Policy        @relation(fields: [policyId], references: [id])
  fromVersion PolicyVersion @relation("ChangeFromVersion", fields: [fromVersionId], references: [id])
  toVersion   PolicyVersion @relation("ChangeToVersion", fields: [toVersionId], references: [id])
  impacts     Impact[]
}

enum ChangeType {
  ADDED
  REMOVED
  MODIFIED
  REORDERED
}

model Impact {
  id             String         @id @default(cuid())
  policyChangeId String
  requirementId  String?
  actionId       String?
  description    String         @db.Text
  reason         String?        @db.Text
  severity       ImpactSeverity @default(MEDIUM)
  status         ImpactStatus   @default(IDENTIFIED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  policyChange PolicyChange @relation(fields: [policyChangeId], references: [id], onDelete: Cascade)
  requirement  Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  action       Action?      @relation(fields: [actionId], references: [id], onDelete: SetNull)
}

enum ImpactSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ImpactStatus {
  IDENTIFIED
  ASSESSED
  MITIGATED
  ACCEPTED
}

// ─── Action History (Audit Log) ──────────────────────────────────────────────

model ActionHistory {
  id        String   @id @default(cuid())
  actionId  String
  userId    String?
  field     String // Which field changed
  oldValue  String?
  newValue  String?
  note      String?
  createdAt DateTime @default(now())

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])
}
